[Unit]
Description=session-minder capture API
After=network.target tailscaled.service

[Service]
Type=simple
WorkingDirectory=/home/john/dev/active/session-minder
EnvironmentFile=/home/john/dev/active/session-minder/.env.local
# Bind the tailnet IP directly — hooks call http://vps8-core:3000 over the
# tailnet. Never 0.0.0.0 (spec: tailnet-only, Non-Goals).
Environment=HOST=100.118.195.63
# The Tailscale short name of this host. The attach endpoint compares it against
# each session row's `host` column, and the hooks record the tailnet short name
# (vps8-core), NOT the provider hostname that os.hostname() returns here
# (srv1086450). Without this, the fallback to hostname() makes EVERY attach
# degrade with `foreign_host` — verified: all 49 captured rows say vps8-core.
# That failure presents to a user as "Herdr isn't working", not as missing config.
Environment=SESSION_MINDER_HOST_NAME=vps8-core
# Invoke node and tsx's CLI directly rather than via npx. systemd's default
# PATH finds /usr/bin/node (v18.19.1), so both `/usr/bin/npx tsx` and
# `/snap/bin/npx tsx` would run this service on Node 18 — below the project's
# Node 20+ requirement, and a version npm itself warns is unsupported.
# This form pins Node v24.18.0 with no PATH dependency and no npm layer.
ExecStart=/snap/bin/node /home/john/dev/active/session-minder/node_modules/tsx/dist/cli.mjs src/index.ts
Restart=on-failure
# If tailscaled hasn't assigned the bound IP yet at boot, app.listen fails
# with EADDRNOTAVAIL and the process exits(1). The default RestartSec=100ms
# would burn StartLimitBurst=5 within the default 10s StartLimitIntervalSec
# and land the unit in `failed`. Give the interface time to come up between
# attempts instead.
RestartSec=5
User=john

[Install]
WantedBy=multi-user.target
