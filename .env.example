# ENVIRONMENT VARIABLES TEMPLATE
# Copy to .env.local and fill in values. Never commit real secrets.

# LLM API Keys
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Project-Specific Keys (add as needed)

# session-minder service config
# Postgres connection string, schema _sessionminder on vps8-core:5433
DATABASE_URL=
# Bearer token the hooks and clients authenticate capture requests with
SESSION_MINDER_TOKEN=
# Port the Fastify server listens on
PORT=
# Tailnet IP to bind — tailnet-only, never 0.0.0.0 (see deploy/session-minder.service)
HOST=
# Tailscale short name of the host this service runs on. Must match the `host`
# value the hook scripts record, or every attach degrades with foreign_host.
SESSION_MINDER_HOST_NAME=vps8-core
# Optional: pin the Herdr socket instead of discovering it. Leave unset to let
# discoverHerdrSocket() walk ~/.config/herdr/sessions/ — which is preferred,
# since the session name changes when the workspace is renamed.
# SESSION_MINDER_HERDR_SOCKET=/home/john/.config/herdr/sessions/herdr-4up/herdr.sock
